// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16],inc, load, reset;
    OUT out[16];
    
    PARTS:
    Inc16(in=regout, out=incremented);
    Mux16(a=regout, b=incremented, sel=inc, out=afterinc);
    Mux16(a=afterinc, b=in, sel=load, out=afterload);
    Mux16(a=afterload, b=false, sel=reset, out=afterreset);
    
    Register(in=afterreset, load=true, out=regout, out=out);
    //since we already set what the values are just keep the register remembering the values
    //we need the register to make the counter clocked
}
